# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Encryption Keys (AES-256-GCM)
# IMPORTANT: Generate these using a secure random generator
# ENCRYPTION_KEY: 32 bytes (64 hex characters or 32 ASCII characters)
# ENCRYPTION_KEY_IV: 16 bytes (32 hex characters or 16 ASCII characters)
# DO NOT change these keys after migration
# DO NOT commit actual keys to version control
ENCRYPTION_KEY=""
ENCRYPTION_KEY_IV=""

# Session
SESSION_SECRET="your-session-secret-here"

# Other configuration...
