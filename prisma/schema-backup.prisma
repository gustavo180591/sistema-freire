generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  passwordHash        String
  firstName           String
  lastName            String
  status              UserStatus               @default(ACTIVE)
  phone               String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  failedLoginAttempts Int                      @default(0)
  lockedUntil         DateTime?
  lastFailedAttempt   DateTime?
  totpSecret          String?
  totpEnabled         Boolean                  @default(false)
  totpVerified        Boolean                  @default(false)
  auditLogs           AuditLog[]
  uploadedMaterials   ClassMaterial[]          @relation("MaterialUploader")
  createdEvaluations  Evaluation[]             @relation("EvaluationCreator")
  closedEvaluations   Evaluation[]             @relation("EvaluationCloser")
  reopenedEvaluations Evaluation[]             @relation("EvaluationReopener")
  createdGrades       Grade[]                  @relation("GradeCreator")
  updatedGrades       Grade[]                  @relation("GradeUpdater")
  payments            Payment[]
  deletedPayslips     Payslip[]                @relation("PayslipDeleter")
  uploadedPayslips    Payslip[]                @relation("PayslipUploader")
  scholarships        Scholarship[]
  sessions            Session[]
  charges             StudentCharge[]
  uploadedDocs        StudentDocument[]        @relation("UploadedBy")
  verifiedDocs        StudentDocument[]        @relation("VerifiedBy")
  createdFollowUps    StudentFollowUp[]        @relation("FollowUpCreator")
  resolvedFollowUps   StudentFollowUp[]        @relation("FollowUpResolver")
  student             Student?
  teacher             Teacher?
  locationPermissions UserLocationPermission[]
  roles               UserRole[]

  @@index([lastName, firstName])
  @@map("users")
}

model Role {
  id    String     @id @default(cuid())
  code  RoleCode   @unique
  name  String
  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Career {
  id                  String               @id @default(cuid())
  code                String               @unique @default(uuid())
  name                String
  trainingField       TrainingField?
  resolution          String?
  durationYears       Int                  @default(4)
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  locations           CareerLocation[]
  careerSubjects      CareerSubject[]
  students            Student[]
  studyPlans          StudyPlan[]
  commissions         SubjectCommission[]
  subjectCorrelatives SubjectCorrelative[]
  enrollments         SubjectEnrollment[]

  @@index([active])
  @@map("careers")
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  entityType  String
  entityId    String?
  description String
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Student {
  id                 String                 @id @default(cuid())
  userId             String                 @unique
  dni                String                 @unique
  firstName          String
  lastName           String
  status             StudentStatus          @default(ACTIVE)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  careerId           String
  currentYear        Int                    @default(1)
  isBecado           Boolean                @default(false)
  isRecursante       Boolean                @default(false)
  birthDate          DateTime?
  bloodType          String?
  phone              String?
  familyContactName  String?
  familyContactPhone String?
  familyRelationship String?
  address            String?
  locality           String?
  postalCode         String?
  highSchool         String?
  highSchoolYear     Int?
  instituteYear      Int?
  academicHistory    AcademicYearHistory[]
  attendanceEntries  AttendanceEntry[]
  grades             Grade[]
  payments           Payment[]
  scholarships       Scholarship[]
  studentCharges     StudentCharge[]
  documents          StudentDocument[]
  followUps          StudentFollowUp[]
  subjectStatuses    StudentSubjectStatus[]
  career             Career                 @relation(fields: [careerId], references: [id])
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments        SubjectEnrollment[]

  @@index([lastName, firstName])
  @@map("students")
}

model AcademicYearHistory {
  id           String             @id @default(cuid())
  studentId    String
  year         Int
  careerId     String
  status       AcademicYearStatus @default(ENROLLED)
  observations String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, year])
  @@index([studentId, year])
  @@index([careerId, year])
  @@map("academic_year_history")
}

model Teacher {
  id           String              @id @default(cuid())
  userId       String              @unique
  dni          String              @unique
  firstName    String
  lastName     String
  status       TeacherStatus       @default(ACTIVE)
  hireDate     DateTime?
  observations String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  payslips     Payslip[]
  commissions  SubjectCommission[]
  subjects     SubjectTeacher[]
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastName, firstName])
  @@index([status])
  @@map("teachers")
}

model Subject {
  id                 String                 @id @default(cuid())
  code               String                 @unique
  name               String
  subjectType        SubjectType
  trainingField      TrainingField
  yearLevel          Int
  accreditationMode  AccreditationMode      @default(EXAMEN_FINAL)
  approvalThreshold  Decimal                @default(6) @db.Decimal(3, 2)
  promotionThreshold Decimal                @default(8) @db.Decimal(3, 2)
  isAnnual           Boolean                @default(true)
  hoursPerWeek       Int?
  isElective         Boolean                @default(false)
  isRemedial         Boolean                @default(false)
  description        String?
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  attendanceRecords  AttendanceRecord[]
  careerSubjects     CareerSubject[]
  materials          ClassMaterial[]
  evaluations        Evaluation[]
  planSubjects       PlanSubject[]
  statuses           StudentSubjectStatus[]
  commissions        SubjectCommission[]
  requiredBy         SubjectCorrelative[]   @relation("subject_required")
  correlatives       SubjectCorrelative[]   @relation("subject_correlatives")
  enrollments        SubjectEnrollment[]
  teachers           SubjectTeacher[]

  @@index([subjectType, yearLevel])
  @@index([trainingField, yearLevel])
  @@index([code, active])
  @@map("subjects")
}

model SubjectTeacher {
  subjectId String
  teacherId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([subjectId, teacherId])
  @@map("subject_teachers")
}

model SubjectCorrelative {
  id                String          @id @default(cuid())
  subjectId         String
  requiredSubjectId String
  correlativeType   CorrelativeType
  careerId          String?
  isActive          Boolean         @default(true)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  career            Career?         @relation(fields: [careerId], references: [id])
  requiredSubject   Subject         @relation("subject_required", fields: [requiredSubjectId], references: [id], onDelete: Cascade)
  subject           Subject         @relation("subject_correlatives", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, requiredSubjectId, careerId])
  @@index([subjectId, correlativeType])
  @@index([requiredSubjectId])
  @@map("subject_correlatives")
}

model CareerSubject {
  id          String   @id @default(cuid())
  careerId    String
  subjectId   String
  isMandatory Boolean  @default(true)
  yearLevel   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  career      Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([careerId, subjectId])
  @@index([careerId, yearLevel])
  @@index([subjectId])
  @@map("career_subjects")
}

model AttendanceRecord {
  id              String             @id @default(cuid())
  subjectId       String
  classDate       DateTime
  commissionId    String? // Opcional para mantener compatibilidad con carga por materia
  createdByUserId String
  createdAt       DateTime           @default(now())
  entries         AttendanceEntry[]
  subject         Subject            @relation(fields: [subjectId], references: [id])
  commission      SubjectCommission? @relation(fields: [commissionId], references: [id])

  // Constraint único: (subjectId, classDate, commissionId)
  // NOTA: En PostgreSQL, NULL en columnas únicas permite duplicados.
  // Cuando commissionId es NULL, múltiples registros con mismo (subjectId, classDate) son permitidos.
  // Esto se mitige con validación backend en las acciones de creación de asistencia.
  @@unique([subjectId, classDate, commissionId])
  @@map("attendance_records")
}

model AttendanceEntry {
  id           String           @id @default(cuid())
  attendanceId String
  studentId    String
  present      Boolean
  notes        String?
  attendance   AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id])

  @@unique([attendanceId, studentId])
  @@index([studentId])
  @@map("attendance_entries")
}

model Grade {
  id              String      @id @default(cuid())
  evaluationId    String
  studentId       String
  status          GradeStatus @default(PRESENT)
  value           Decimal?    @db.Decimal(5, 2)
  observations    String?
  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  evaluation    Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdByUser User       @relation("GradeCreator", fields: [createdByUserId], references: [id])
  updatedByUser User?      @relation("GradeUpdater", fields: [updatedByUserId], references: [id])

  @@unique([evaluationId, studentId])
  @@index([studentId])
  @@index([evaluationId])
  @@map("grades")
}

model StudentSubjectStatus {
  id                String           @id @default(cuid())
  studentId         String
  subjectId         String
  attendancePercent Decimal          @default(0) @db.Decimal(5, 2)
  regularityStatus  RegularityStatus @default(LIBRE)
  courseAverage     Decimal?         @db.Decimal(5, 2)
  courseStatus      CourseStatus     @default(IN_PROGRESS)
  finalExamScore    Decimal?         @db.Decimal(5, 2)
  finalExamStatus   FinalExamStatus  @default(PENDING)
  academicStatus    AcademicStatus   @default(EN_COURSE)
  promotionDate     DateTime?
  finalApprovalDate DateTime?
  updatedAt         DateTime         @updatedAt
  approved          Boolean          @default(false)
  promoted          Boolean          @default(false)
  finalGrade        Decimal?         @db.Decimal(5, 2)
  student           Student          @relation(fields: [studentId], references: [id])
  subject           Subject          @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId])
  @@index([studentId, regularityStatus])
  @@index([studentId, courseStatus])
  @@index([studentId, academicStatus])
  @@map("student_subject_status")
}

model StudyPlan {
  id            String              @id @default(cuid())
  careerId      String
  name          String
  version       String
  isDefault     Boolean             @default(false)
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  durationYears Int                 @default(4)
  subjects      PlanSubject[]
  career        Career              @relation(fields: [careerId], references: [id])
  commissions   SubjectCommission[]
  enrollments   SubjectEnrollment[]

  @@unique([careerId, version])
  @@map("study_plans")
}

model PlanSubject {
  planId    String
  subjectId String
  sortOrder Int
  plan      StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id])

  @@id([planId, subjectId])
  @@map("plan_subjects")
}

model ChargeConcept {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  description String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  charges     StudentCharge[]

  @@map("charge_concepts")
}

model StudentCharge {
  id             String              @id @default(cuid())
  studentId      String
  conceptId      String
  periodLabel    String
  amount         Decimal             @db.Decimal(12, 2)
  paidAmount     Decimal             @default(0) @db.Decimal(12, 2)
  dueDate        DateTime?
  status         ChargeStatus        @default(PENDING)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  userId         String?
  academicTermId String?
  allocations    PaymentAllocation[]
  academicTerm   AcademicTerm?       @relation(fields: [academicTermId], references: [id])
  concept        ChargeConcept       @relation(fields: [conceptId], references: [id])
  student        Student             @relation(fields: [studentId], references: [id])
  user           User?               @relation(fields: [userId], references: [id])

  @@index([studentId, status])
  @@index([periodLabel])
  @@index([academicTermId])
  @@map("student_charges")
}

model Payment {
  id             String              @id @default(cuid())
  studentId      String
  amount         Decimal             @db.Decimal(12, 2)
  method         PaymentMethod
  reference      String?
  paidAt         DateTime            @default(now())
  notes          String?
  createdAt      DateTime            @default(now())
  userId         String?
  academicTermId String?
  allocations    PaymentAllocation[]
  academicTerm   AcademicTerm?       @relation(fields: [academicTermId], references: [id])
  student        Student             @relation(fields: [studentId], references: [id])
  user           User?               @relation(fields: [userId], references: [id])

  @@index([studentId, paidAt])
  @@index([academicTermId])
  @@map("payments")
}

model PaymentAllocation {
  paymentId String
  chargeId  String
  amount    Decimal       @db.Decimal(12, 2)
  charge    StudentCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@id([paymentId, chargeId])
  @@map("payment_allocations")
}

model Scholarship {
  id         String    @id @default(cuid())
  studentId  String
  name       String
  percentage Decimal   @db.Decimal(5, 2)
  active     Boolean   @default(true)
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String?
  student    Student   @relation(fields: [studentId], references: [id])
  user       User?     @relation(fields: [userId], references: [id])

  @@index([studentId, active])
  @@map("scholarships")
}

model Payslip {
  id               String        @id @default(cuid())
  teacherId        String
  periodMonth      Int
  periodYear       Int
  amount           Decimal       @db.Decimal(12, 2)
  status           PayslipStatus @default(PENDING)
  fileUrl          String?
  fileKey          String?
  fileSize         Int?
  mimeType         String?
  originalFileName String?
  notes            String?
  uploadedBy       String?
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deleter          User?         @relation("PayslipDeleter", fields: [deletedBy], references: [id])
  teacher          Teacher       @relation(fields: [teacherId], references: [id])
  uploader         User?         @relation("PayslipUploader", fields: [uploadedBy], references: [id])

  @@unique([teacherId, periodMonth, periodYear])
  @@index([teacherId, periodYear, periodMonth])
  @@index([uploadedBy])
  @@index([deletedAt])
  @@map("payslips")
}

model Permission {
  id        String   @id @default(cuid())
  roleCode  RoleCode
  entity    String
  canCreate Boolean  @default(false)
  canRead   Boolean  @default(true)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleCode, entity])
  @@index([roleCode])
  @@index([entity])
  @@map("permissions")
}

model Location {
  id              String                   @id @default(cuid())
  name            String                   @unique
  code            String                   @unique
  address         String?
  city            String?
  province        String?
  phone           String?
  email           String?
  active          Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  academicTerms   AcademicTerm[]
  careers         CareerLocation[]
  commissions     SubjectCommission[]
  userPermissions UserLocationPermission[]

  @@index([active])
  @@map("locations")
}

model CareerLocation {
  id         String   @id @default(cuid())
  careerId   String
  locationId String
  createdAt  DateTime @default(now())
  career     Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([careerId, locationId])
  @@index([careerId])
  @@index([locationId])
  @@map("career_locations")
}

model UserLocationPermission {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  createdAt  DateTime @default(now())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
  @@map("user_location_permissions")
}

model AcademicTerm {
  id          String              @id @default(cuid())
  name        String
  code        String              @unique
  year        Int
  termType    TermType
  startDate   DateTime
  endDate     DateTime
  active      Boolean             @default(true)
  locationId  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  location    Location?           @relation(fields: [locationId], references: [id])
  payments    Payment[]
  charges     StudentCharge[]
  commissions SubjectCommission[]
  enrollments SubjectEnrollment[]

  @@index([year, active])
  @@index([locationId, active])
  @@map("academic_terms")
}

model StudentDocument {
  id         String       @id @default(cuid())
  studentId  String
  type       DocumentType
  name       String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  uploadedBy String
  verified   Boolean      @default(false)
  verifiedBy String?
  verifiedAt DateTime?
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploader   User         @relation("UploadedBy", fields: [uploadedBy], references: [id])
  verifier   User?        @relation("VerifiedBy", fields: [verifiedBy], references: [id])

  @@index([studentId, type])
  @@map("student_documents")
}

model StudentFollowUp {
  id          String       @id @default(cuid())
  studentId   String
  type        FollowUpType
  title       String
  description String
  date        DateTime     @default(now())
  createdBy   String
  isAlert     Boolean      @default(false)
  isResolved  Boolean      @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?
  attachments String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  creator     User         @relation("FollowUpCreator", fields: [createdBy], references: [id])
  resolver    User?        @relation("FollowUpResolver", fields: [resolvedBy], references: [id])
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, date])
  @@index([studentId, type])
  @@map("student_followups")
}

model ClassMaterial {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  description String?
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  uploadedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploader    User     @relation("MaterialUploader", fields: [uploadedBy], references: [id])

  @@index([subjectId])
  @@index([uploadedBy])
  @@map("class_materials")
}

model Evaluation {
  id                 String         @id @default(cuid())
  subjectId          String
  commissionId       String?
  title              String
  description        String?
  type               EvaluationType
  evaluationDate     DateTime
  maxScore           Decimal        @default(10) @db.Decimal(6, 2)
  minPassingScore    Decimal        @default(6) @db.Decimal(6, 2)
  weight             Decimal        @default(1) @db.Decimal(6, 2)
  observations       String?
  isClosed           Boolean        @default(false)
  closedAt           DateTime?
  closedByUserId     String?
  closedReason       String?
  reopenedAt         DateTime?
  reopenedByUserId   String?
  reopenReason       String?
  parentEvaluationId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  createdByUserId    String

  subject             Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  commission          SubjectCommission? @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  createdByUser       User               @relation("EvaluationCreator", fields: [createdByUserId], references: [id])
  closedByUser        User?              @relation("EvaluationCloser", fields: [closedByUserId], references: [id])
  reopenedByUser      User?              @relation("EvaluationReopener", fields: [reopenedByUserId], references: [id])
  parentEvaluation    Evaluation?        @relation("EvaluationRecovery", fields: [parentEvaluationId], references: [id])
  recoveryEvaluations Evaluation[]       @relation("EvaluationRecovery")
  grades              Grade[]

  @@index([subjectId])
  @@index([commissionId])
  @@index([createdByUserId])
  @@index([evaluationDate])
  @@index([isClosed])
  @@index([parentEvaluationId])
  @@map("evaluations")
}

model SubjectCommission {
  id                String              @id @default(cuid())
  code              String              @unique
  subjectId         String
  academicTermId    String?
  careerId          String?
  studyPlanId       String?
  teacherId         String?
  locationId        String?
  maxCapacity       Int                 @default(40)
  currentEnrolled   Int                 @default(0)
  schedule          String?
  scheduleJson      Json?
  active            Boolean             @default(true)
  observations      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  attendanceRecords AttendanceRecord[]
  evaluations       Evaluation[]
  academicTerm      AcademicTerm?       @relation(fields: [academicTermId], references: [id])
  career            Career?             @relation(fields: [careerId], references: [id])
  location          Location?           @relation(fields: [locationId], references: [id])
  studyPlan         StudyPlan?          @relation(fields: [studyPlanId], references: [id])
  subject           Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher           Teacher?            @relation(fields: [teacherId], references: [id])
  enrollments       SubjectEnrollment[]

  @@index([subjectId, active])
  @@index([academicTermId, active])
  @@index([careerId, active])
  @@index([teacherId])
  @@map("subject_commissions")
}

model SubjectEnrollment {
  id                 String             @id @default(cuid())
  studentId          String
  subjectId          String
  commissionId       String?
  careerId           String
  studyPlanId        String?
  academicTermId     String?
  status             EnrollmentStatus   @default(PENDING)
  enrolledAt         DateTime           @default(now())
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  cancellationReason String?
  observations       String?
  enrolledBy         String?
  confirmedBy        String?
  cancelledBy        String?
  rejectedBy         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  academicTerm       AcademicTerm?      @relation(fields: [academicTermId], references: [id])
  career             Career             @relation(fields: [careerId], references: [id])
  commission         SubjectCommission? @relation(fields: [commissionId], references: [id])
  student            Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studyPlan          StudyPlan?         @relation(fields: [studyPlanId], references: [id])
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, academicTermId])
  @@index([studentId, status])
  @@index([subjectId, status])
  @@index([commissionId])
  @@index([academicTermId, status])
  @@map("subject_enrollments")
}

